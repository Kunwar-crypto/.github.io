---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { research } from '../lib/content.js';
const base=import.meta.env.BASE_URL||'/';
const href=(p)=>`${base}${p.replace(/^\//,'')}`;
---
<BaseLayout title="Research">
<PageHero eyebrow="MY RESEARCH" title="From pixel to prediction." description="Developing remote-sensing and data-driven approaches to observe, estimate, and forecast water quality in dynamic river environments."/>
<section class="section"><div class="container"><span class="eyebrow">THREE CONNECTED DIRECTIONS</span><div style="margin-top:24px">{research.map(r=><article class="research-full"><div class="number">{r.number}</div><div><span class="eyebrow">{r.label}</span><h2>{r.title}</h2><p>{r.description}</p>{r.image && <img class="research-detail-image" src={href(r.image)} alt={`Research illustration: ${r.title}`} loading="lazy" />}<div class="method-list">{r.methods.map(m=><span class="tag">{m}</span>)}</div><div class="research-outcome"><strong>Research contribution:</strong> {r.outcome}</div><a class="text-link" href={r.link} target="_blank" rel="noopener noreferrer">Read associated publication ↗</a></div></article>)}</div></div></section>
<section class="cta"><div class="container cta-inner"><div><span class="eyebrow" style="color:#95dfc1">WHAT'S NEXT</span><h2>Integrated water quantity and quality monitoring.</h2><p>Future interests include linking satellite observations with hydrology, aquatic ecosystem indicators and practical environmental assessment; the proposed directions are research interests, not completed projects.</p></div><a class="btn btn-primary" href="mailto:kasingh2694@gmail.com">Discuss collaboration ↗</a></div></section>
</BaseLayout>
