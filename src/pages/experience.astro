---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { experiences } from '../lib/content.js';
import education from '../data/education.json';
---
<BaseLayout title="Experience">
<PageHero eyebrow="EXPERIENCE & EDUCATION" title="Research. Teaching. Service." description="Interdisciplinary academic preparation, hands-on teaching, and service to research communities."/>
<section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">ACADEMIC ROLES</span><h2>Teaching & responsibility.</h2></div></div><div class="timeline">{experiences.map(e=><article class="timeline-row"><span class="timeline-date">{e.period} · {e.type}</span><h3>{e.role}</h3><p><strong>{e.organization}</strong></p><p>{e.description}</p></article>)}</div></div></section>
<section class="section" style="background:#f0f5f0"><div class="container"><div class="section-head"><div><span class="eyebrow">EDUCATION</span><h2>Academic foundations.</h2></div></div><div class="timeline">{education.map(e=><article class="timeline-row"><span class="timeline-date">{e.year}</span><h3>{e.degree}</h3><p><strong>{e.institution}</strong><br/>{e.detail}</p></article>)}</div></div></section>
</BaseLayout>
