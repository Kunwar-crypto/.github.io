---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchCards from '../components/ResearchCards.astro';
import site from '../data/site.json';
import education from '../data/education.json';
import { journalPapers, phdPapers, publications, awards, news, prettyDate } from '../lib/content.js';
const base=import.meta.env.BASE_URL || '/';
const href=(p='')=>`${base}${String(p).replace(/^\//,'')}`;
---
<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="hero-label"><span class="dot"></span> {site.eyebrow}</div>
        <div class="eyebrow" style="color:#b2edd8;margin-bottom:17px">{site.name}, {site.credentials}</div>
        <h1>{site.hero_title_prefix}<span class="accent-word">{site.hero_title_accent}</span>{site.hero_title_suffix}</h1>
        <p class="hero-title">{site.current_title}</p>
        <p class="hero-desc">{site.tagline}</p>
        <div class="hero-actions"><a class="btn btn-primary" href={href('research/')}>Explore my research <span class="arrow">↗</span></a><a class="btn btn-outline" href={href(site.cv_path)} target="_blank" rel="noopener">Download CV ↓</a></div>
        <div class="hero-affil"><span>JOINT PhD ALUMNUS</span><b>{site.affiliation_1}</b><span>×</span><b>{site.affiliation_2}</b></div>
      </div>
      <div class="hero-photo-wrap"><div class="hero-photo-frame"><img src={href(site.portrait)} alt={`Portrait of ${site.name}`} fetchpriority="high" /></div><div class="photo-label"><strong>{site.name}, PhD</strong><small>Satellite remote sensing · Environmental AI</small></div></div>
    </div>
  </section>
  <section class="earth-observation-feature" aria-labelledby="earth-feature-title">
    <div class="container earth-feature-inner">
      <div class="earth-feature-copy">
        <span class="eyebrow earth-feature-eyebrow">EARTH OBSERVATION IN ACTION</span>
        <h2 id="earth-feature-title">From orbit to <span>river insight.</span></h2>
        <p>Linking satellite observations, hydroclimate information and data-driven modelling to better understand and forecast water quality.</p>
        <div class="earth-feature-sequence" aria-label="Research workflow"><span>OBSERVE</span><b>—</b><span>UNDERSTAND</span><b>—</b><span>FORECAST</span></div>
        <a class="earth-feature-link" href={href('research/')}>Explore my research <span aria-hidden="true">↗</span></a>
      </div>
      <div class="earth-feature-visual" aria-label="Earth as observed by remote-sensing satellites">
        <span class="earth-orbit earth-orbit-one" aria-hidden="true"></span><span class="earth-orbit earth-orbit-two" aria-hidden="true"></span>
        <img class="earth-globe" src={href('assets/earth-globe.webp')} alt="NASA Blue Marble imagery shown as an Earth globe with Asia and the Indian Ocean in view" loading="lazy" />
        <div class="earth-satellite" aria-hidden="true">
          <svg viewBox="0 0 150 100" xmlns="http://www.w3.org/2000/svg" role="presentation">
            <path d="M68 53L44 92h75L91 52" fill="#69d6b1" fill-opacity=".10" stroke="#81e2c3" stroke-width="1" stroke-opacity=".25"/>
            <g transform="translate(74 29) rotate(-22)">
              <rect x="-18" y="-8" width="36" height="21" rx="4" fill="#e0fdf7" stroke="#8ae5d0" stroke-width="2"/>
              <rect x="-62" y="-10" width="39" height="23" rx="2" fill="#0a607a" stroke="#81e2c3" stroke-width="2"/>
              <path d="M-49 -10v23M-36 -10v23M-62 1.5h39" stroke="#71d6c6" stroke-opacity=".72"/>
              <rect x="23" y="-10" width="39" height="23" rx="2" fill="#0a607a" stroke="#81e2c3" stroke-width="2"/>
              <path d="M36 -10v23M49 -10v23M23 1.5h39" stroke="#71d6c6" stroke-opacity=".72"/>
              <path d="M-23 1h5M18 1h5" stroke="#d7fff5" stroke-width="3"/>
              <circle cx="0" cy="2" r="5" fill="#157a7a"/>
              <path d="M-3 -16V-24M-9 -24H3" fill="none" stroke="#a1f4df" stroke-width="2"/>
            </g>
          </svg>
        </div>
      </div>
    </div>
    <div class="earth-feature-credit">Earth imagery: NASA Blue Marble (illustrative orthographic view) · Not a real-time satellite feed</div>
  </section>
  <section class="section" id="about"><div class="container intro-grid"><div><span class="eyebrow">INTRODUCTION</span><h2>Science at the intersection of <span style="color:#1c8880">water</span> and space.</h2><a class="text-link" href={href('about/')}>More about me <span class="arrow">↗</span></a></div><div class="intro-content"><p>{site.bio_short}</p><p>My work focuses on turning complex environmental data into useful evidence for monitoring, modelling, and decision-making in freshwater environments.</p><div class="pill-row"><span class="tag">Optical remote sensing</span><span class="tag">Machine learning</span><span class="tag">Water-quality forecasting</span><span class="tag">Google Earth Engine</span><span class="tag">Hydroinformatics</span></div></div></div></section>
  <section class="section" style="background:#f0f5f0"><div class="container"><div class="section-head"><div><span class="eyebrow">SIGNATURE WORK</span><h2>Research that moves<br/>beyond observation.</h2></div><p>Three connected strands of research, spanning satellite retrieval, estimation, and seasonal prediction.</p></div><ResearchCards /></div></section>
  <section class="section dark-section"><div class="container"><div class="section-head"><div><span class="eyebrow" style="color:#7cddbe">SELECTED PUBLICATIONS</span><h2>Ideas, tested.<br/>Research, published.</h2></div><a class="btn btn-outline" href={href('publications/')}>All publications ↗</a></div><div>{publications.filter(p=>p.featured).slice(0,3).map(pub=><article class="publication-item"><span class="pub-year">{pub.year}</span><div class="pub-details"><h3>{pub.title}</h3><p>{pub.journal} · <span class="topic">{pub.theme}</span></p></div><a class="pub-link" href={pub.doi} target="_blank" rel="noopener noreferrer" aria-label={`Open publication ${pub.title}`}>↗</a></article>)}</div></div></section>
  <section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">EDUCATION & BACKGROUND</span><h2>Built across disciplines<br/>and institutions.</h2></div><p>From civil engineering to geospatial analysis and doctoral research in environmental remote sensing.</p></div><div class="surface-grid"><div class="glass-card"><div class="icon-box" aria-hidden="true">⌁</div><h3>Academic journey</h3><div class="timeline" style="margin-top:28px">{education.map(e=><div class="timeline-row"><div class="timeline-date">{e.year}</div><h3>{e.degree}</h3><p>{e.institution}</p></div>)}</div><a class="text-link" href={href('about/')}>Full background ↗</a></div><div class="glass-card"><div class="icon-box" aria-hidden="true">✦</div><h3>Research toolkit</h3><p>A combination of Earth observation and applied modelling techniques.</p><div class="pill-row"><span class="tag">Sentinel-2 MSI</span><span class="tag">Python</span><span class="tag">GEE</span><span class="tag">ArcGIS / QGIS</span><span class="tag">Machine learning</span><span class="tag">Statistical modelling</span><span class="tag">Seasonal forecasting</span><span class="tag">ERA5 / C3S</span></div><div style="margin-top:35px;padding:22px;background:#eaf5ef;border-radius:14px"><span class="eyebrow">RESEARCH DIRECTION</span><p style="margin:12px 0 0">Integrated water quantity and quality, optical water monitoring, and scalable environmental decision support.</p></div></div></div></div></section>
  <section class="section" style="background:#f0f5f0"><div class="container"><div class="section-head"><div><span class="eyebrow">RECOGNITION</span><h2>Selected honours<br/>and milestones.</h2></div><a class="text-link" href={href('awards/')}>View all awards ↗</a></div><div class="award-grid">{awards.filter(a=>a.featured).slice(0,3).map(a=><article class="award-card"><span class="award-year">{a.year} ✳</span><h3>{a.title}</h3><p>{a.issuer}</p></article>)}</div></div></section>
  <section class="section tight"><div class="container"><div class="section-head"><div><span class="eyebrow">LATEST NOTES</span><h2>News & updates.</h2></div></div><div class="updates">{news.slice(0,3).map(n=><article class="update"><small>{prettyDate(n.date)}</small><h3>{n.title}</h3><p>{n.description}</p>{n.link && <a class="text-link" href={n.link} target="_blank" rel="noopener noreferrer">Read more ↗</a>}</article>)}</div></div></section>
  <section class="cta"><div class="container cta-inner"><div><span class="eyebrow" style="color:#9deaca">COLLABORATE</span><h2>Better environmental intelligence starts with shared ideas.</h2><p>{site.collaboration_message}</p></div><a class="btn btn-primary" href={href('contact/')}>Get in touch ↗</a></div></section>
</BaseLayout>
