---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { publications, journalPapers } from '../lib/content.js';
---
<BaseLayout title="Publications">
<PageHero eyebrow="PUBLICATIONS" title="Peer-reviewed research & scholarly work." description="Selected journal papers, conference contributions and science communication covering satellite-based water monitoring, streamflow and environmental modelling."/>
<section class="section"><div class="container"><div class="pub-filter"><input id="pub-search" class="search" type="search" placeholder="Search title, journal or research topic…" aria-label="Search publications"/><div class="filter-row" role="group" aria-label="Publication type"><button type="button" class="filter-button" data-filter="all" aria-pressed="true">All</button><button type="button" class="filter-button" data-filter="Journal article" aria-pressed="false">Journal articles</button><button type="button" class="filter-button" data-filter="Conference presentation" aria-pressed="false">Conferences</button><button type="button" class="filter-button" data-filter="Research case study" aria-pressed="false">Other</button></div></div><p class="mini-note">{journalPapers.length} journal articles and {publications.length-journalPapers.length} other selected scholarly contributions in this portfolio.</p><div class="pub-light" id="publications-list">{publications.map(p=><article class="publication-item" data-category={p.category} data-search={`${p.title} ${p.journal} ${p.theme} ${p.year}`.toLowerCase()}><span class="pub-year">{p.year}</span><div class="pub-details"><div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:8px"><span class="tag">{p.category}</span>{p.featured && <span class="tag">PhD research</span>}</div><h3>{p.title}</h3><p><strong>{p.journal}</strong>{p.volume ? ` · ${p.volume}` : ''}{p.pages ? ` · ${p.pages}` : ''}</p><p style="margin-top:8px">{p.summary}</p><p style="margin-top:9px"><span class="topic">{p.theme}</span></p></div><a href={p.doi} class="pub-link" aria-label={`Read ${p.title}`} target="_blank" rel="noopener noreferrer">↗</a></article>)}</div><p class="not-found" id="no-results" style="display:none">No publications match that search. Try another keyword or category.</p></div></section>
<script>
const input=document.getElementById('pub-search');const buttons=[...document.querySelectorAll('.filter-button')];const rows=[...document.querySelectorAll('#publications-list .publication-item')];let selected='all';const update=()=>{const term=(input?.value||'').toLowerCase().trim();let count=0;rows.forEach(r=>{const show=(selected==='all'||r.dataset.category===selected)&&(!term||r.dataset.search?.includes(term));r.hidden=!show;if(show)count++});document.getElementById('no-results').style.display=count?'none':'block'};input?.addEventListener('input',update);buttons.forEach(b=>b.addEventListener('click',()=>{selected=b.dataset.filter;buttons.forEach(x=>x.setAttribute('aria-pressed',String(x===b)));update()}));
</script>
<style>.publication-item[hidden]{display:none}</style>
</BaseLayout>
