---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import site from '../data/site.json';
import education from '../data/education.json';
const base=import.meta.env.BASE_URL||'/';const href=(p)=>`${base}${p.replace(/^\//,'')}`;
---
<BaseLayout title="About">
<PageHero eyebrow="ABOUT ME" title="Curiosity shaped by Earth, water, and data." description="An interdisciplinary researcher working at the intersection of remote sensing, machine learning, water resources, and environmental sustainability."/>
<section class="section"><div class="container intro-grid"><div><span class="eyebrow">MY STORY</span><h2>Understanding rivers through the lens of satellite data.</h2><img src={href(site.portrait)} alt={`Portrait of ${site.name}`} style="width:270px;border-radius:20px;margin-top:35px" loading="lazy" /></div><div class="intro-content"><p>{site.bio_long}</p><p>My academic journey began in Civil Engineering at NIT Raipur, continued through an M.Tech. in Remote Sensing and GIS at the Indian Institute of Remote Sensing, and culminated in a joint PhD through IIT Kharagpur and the University of Melbourne.</p><div class="pill-row"><span class="tag">Earth observation</span><span class="tag">Environmental AI</span><span class="tag">Hydroclimate</span><span class="tag">Water resources</span></div></div></div></section>
<section class="section" style="background:#f0f5f0"><div class="container"><div class="section-head"><div><span class="eyebrow">QUALIFICATIONS</span><h2>Academic background.</h2></div></div><div class="timeline">{education.map(e=><div class="timeline-row"><div class="timeline-date">{e.year}</div><h3>{e.degree}</h3><p><strong>{e.institution}</strong><br/>{e.detail}</p></div>)}</div></div></section>
<section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">EXPERTISE</span><h2>Research capabilities.</h2></div></div><div class="surface-grid"><article class="glass-card"><h3>Satellite & geospatial analysis</h3><p>Optical remote sensing, satellite image processing, Google Earth Engine, GIS, Sentinel-2 MSI, and multisource environmental analysis.</p></article><article class="glass-card"><h3>Statistical & AI modelling</h3><p>Python, machine learning, statistical modelling, feature selection, data-driven estimation, and seasonal forecast evaluation.</p></article></div></div></section>
</BaseLayout>
