---
import { research } from '../lib/content.js';
const base = import.meta.env.BASE_URL || '/';
const href = (p='') => `${base}${p.replace(/^\//,'')}`;
---
<div class="research-grid">
  {research.map(r =>
    <article class="research-card">
      <span class="num">{r.number}</span>
      {r.image && <img class="research-card-image" src={href(r.image)} alt={`Illustration for ${r.title}`} loading="lazy" />}
      <span class="mini-label">{r.label}</span>
      <h3>{r.title}</h3>
      <p>{r.description}</p>
      <div class="footer-link"><a class="text-link" href={href('research/')}>Explore research <span class="arrow">↗</span></a></div>
    </article>
  )}
</div>
